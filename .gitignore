# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite database
*.db
*.db-journal
*.db-shm
*.db-wal

# Hand-transcribed GBP reviews — real reviewer names; kept out of git and
# copied to the server for the one-time import. See scripts/import-google-reviews.mjs
scripts/data/google-reviews.json

# Locally, media uploads land in ./uploads (in production this is the
# mounted data volume). User-uploaded content is never source.
uploads/
